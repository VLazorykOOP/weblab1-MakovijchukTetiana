<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <title>Лабораторна робота №8 </title>
    <style>
        body {
            font-family: Arial, sans-serif;
            display: flex;
            flex-direction: column;
            align-items: center;
            background-color: #f9f9f9;
        }
        canvas {
            background: white;
            border: 2px solid #333;
            margin-top: 20px;
            cursor: pointer;
        }
    </style>
</head>
<body>

    <h3>Лабораторна робота №8</h3>
    <canvas id="myCanvas" width="600" height="500"></canvas>

    <script>
        window.onload = function() {
            const canvas = document.getElementById("myCanvas");
            const ctx = canvas.getContext("2d");

            let isAnimating = true; 
            
            let moveOffset = 0;       
            let moveDirection = 2;    
            
            let scaleFactor = 1;
            let scaleDirection = 0.01;
            let colorTime = 0;

            function drawArrow(fromX, fromY, toX, toY) {
                ctx.beginPath();
                ctx.moveTo(fromX, fromY);
                ctx.lineTo(toX, toY);
                ctx.stroke();
                const headlen = 10; 
                const angle = Math.atan2(toY - fromY, toX - fromX);
                ctx.beginPath();
                ctx.moveTo(toX, toY);
                ctx.lineTo(toX - headlen * Math.cos(angle - Math.PI / 6), toY - headlen * Math.sin(angle - Math.PI / 6));
                ctx.lineTo(toX - headlen * Math.cos(angle + Math.PI / 6), toY - headlen * Math.sin(angle + Math.PI / 6));
                ctx.lineTo(toX, toY);
                ctx.fillStyle = "black";
                ctx.fill();
            }

            function drawAxes() {
                ctx.lineWidth = 2;
                ctx.strokeStyle = "black";
                ctx.fillStyle = "black";
                ctx.font = "14px Arial";
                ctx.textAlign = "center";
                drawArrow(50, 250, 450, 250);
                ctx.fillText("X", 440, 275);
                drawArrow(100, 400, 100, 50);
                ctx.fillText("Y", 120, 60);
                for(let i=1; i<=5; i++) {
                    let x = 100 + i*50;
                    ctx.beginPath(); ctx.moveTo(x, 245); ctx.lineTo(x, 255); ctx.stroke();
                    ctx.fillText(i, x, 270);
                }
                const yLabels = {200: "1", 150: "2", 300: "-1", 350: "-2"};
                for (let y in yLabels) {
                    ctx.beginPath(); ctx.moveTo(95, y); ctx.lineTo(105, y); ctx.stroke();
                    ctx.fillText(yLabels[y], 85, parseInt(y)+5);
                }
            }

            function drawShapes() {
                ctx.save(); 
                ctx.lineWidth = 1;

                ctx.save();
                ctx.translate(moveOffset, 0); 
                ctx.fillStyle = "blue"; 
                ctx.strokeStyle = "black";
                ctx.fillRect(200, 100, 100, 50); 
                ctx.strokeRect(200, 100, 100, 50);
                ctx.restore();

                ctx.save();
                ctx.translate(250, 250); 
                ctx.scale(1 * scaleFactor, 2); 
                let r = Math.floor(Math.abs(Math.sin(colorTime)) * 255);
                ctx.fillStyle = "rgb(" + r + ", 0, 255)";
                ctx.beginPath();
                ctx.arc(0, 0, 50, 0, 2 * Math.PI); 
                ctx.fill();
                ctx.stroke();
                ctx.restore(); 

                ctx.fillStyle = "blue"; 

                ctx.fillRect(100, 150, 50, 50);
                ctx.strokeRect(100, 150, 50, 50);
                
                ctx.beginPath();
                ctx.arc(125, 225, 25, 0, 2 * Math.PI); 
                ctx.fill();
                ctx.stroke();

                ctx.save();
                ctx.translate(125, 280); 
                ctx.beginPath();
                ctx.moveTo(-25, 20); ctx.lineTo(25, 20); ctx.lineTo(0, -30);
                ctx.closePath();
                ctx.fill();
                ctx.stroke();
                ctx.restore();

                ctx.fillRect(350, 150, 50, 50);
                ctx.strokeRect(350, 150, 50, 50);

                ctx.beginPath();
                ctx.arc(375, 225, 25, 0, 2 * Math.PI);
                ctx.fill();
                ctx.stroke();

                ctx.save();
                ctx.translate(375, 280);
                ctx.beginPath();
                ctx.moveTo(-25, 20); ctx.lineTo(25, 20); ctx.lineTo(0, -30);
                ctx.closePath();
                ctx.fill();
                ctx.stroke();
                ctx.restore();

                ctx.fillRect(150, 300, 50, 50); ctx.strokeRect(150, 300, 50, 50);
                ctx.fillRect(300, 300, 50, 50); ctx.strokeRect(300, 300, 50, 50);

                ctx.fillStyle = "#00008B";
                ctx.font = "bold 20px Verdana";
                ctx.fillText("Варіант №10", 300, 40);

                ctx.restore(); 
            }

            function animate() {
                if (!isAnimating) return; 

                ctx.clearRect(0, 0, canvas.width, canvas.height);
                drawAxes(); 
   
                moveOffset += moveDirection;
                if (moveOffset > 50 || moveOffset < -50) {
                    moveDirection *= -1;
                }

                colorTime += 0.05; 
                scaleFactor += scaleDirection;
                if (scaleFactor > 1.1 || scaleFactor < 0.9) {
                    scaleDirection *= -1;
                }

                drawShapes(); 
                requestAnimationFrame(animate); 
            }

            canvas.addEventListener('mousedown', function() {
                isAnimating = !isAnimating;
                if (isAnimating) animate();
            });

            animate(); 
        };
    </script>
</body>
</html>
